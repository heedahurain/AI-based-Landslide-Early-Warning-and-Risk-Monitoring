# ShailSuraksha environment.
#
# Copy to .env and adjust. Every value here is safe to commit: the file
# contains no real secret, and the API refuses to start outside development if
# JWT_SECRET_KEY is still the placeholder below.
#
#   cp .env.example .env

# --- Service ----------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
API_PORT=8000
WEB_PORT=3000

# --- PostgreSQL 16 with PostGIS and TimescaleDB -----------------------------
POSTGRES_USER=shail
POSTGRES_PASSWORD=shail
POSTGRES_DB=shailsuraksha
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://shail:shail@localhost:5432/shailsuraksha

# --- Redis: cache, Celery broker, alert bus ---------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- MQTT: field sensor telemetry -------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_TOPIC_PREFIX=shailsuraksha/sensors

# --- MinIO: rasters, tiles, citizen media, model artefacts ------------------
MINIO_ENDPOINT=localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=shailsuraksha

# --- MLflow -----------------------------------------------------------------
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Security ---------------------------------------------------------------
# Replace before any deployment. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-not-a-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=["http://localhost:3000"]

# --- Data provider toggles --------------------------------------------------
# Switching a provider off routes it to the seeded synthetic engine, and the UI
# labels the result SIMULATED. It never silently substitutes data.
ENABLE_OPEN_METEO=true
ENABLE_NASA_POWER=true
ENABLE_PLANETARY_COMPUTER=true
ENABLE_OSM=true
ENABLE_GPM_IMERG=false
PROVIDER_CACHE_TTL_SECONDS=1800
PROVIDER_TIMEOUT_SECONDS=20

# --- Credentials for key-gated sources --------------------------------------
# Both are free. Neither is required: Planetary Computer covers the DEM without
# a key, and IMERG stays disabled until Earthdata credentials are present.
# Earthdata registration: https://urs.earthdata.nasa.gov
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# OpenTopography key: https://portal.opentopography.org
OPENTOPOGRAPHY_API_KEY=

# --- Synthetic engine -------------------------------------------------------
# Fixed seed so a demo is reproducible hour for hour.
SYNTHETIC_SEED=26001

# --- Alert delivery channels ------------------------------------------------
# With no credentials the stub provider logs messages to a developer inbox in
# the UI, so the full alert path is demonstrable offline.
SMS_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Web push. Generate a VAPID key pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@shailsuraksha.in

# --- Web --------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
